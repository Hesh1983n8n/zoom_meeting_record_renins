AUTH_BASE_URL=https://mymeetai.site
AUTH_TOKEN_ENDPOINT=/token/meeting-sdk-jwt
MEETAI_API_KEY=your_meetai_api_key_here
BOT_BASE_URL=http://bot:3667
BOT_DISPLAY_NAME=Renins Bot
RECORDS_DIR=/records
BOT_PORT=3667

# Final mix/timeline settings
FINAL_MIX_ENABLE=true
FINAL_MIX_SAMPLE_RATE=48000
FINAL_MIX_CHANNELS=1
VAD_ENABLE=true
VAD_FRAME_MS=20
VAD_ENERGY_THRESHOLD=0.015
VAD_MIN_SPEECH_MS=200
VAD_MIN_SILENCE_MS=400
